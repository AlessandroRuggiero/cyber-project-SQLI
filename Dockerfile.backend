FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY cbr_project ./cbr_project

ENV DATABASE_PATH=/data/database.db \
    PYTHONUNBUFFERED=1

RUN mkdir -p /data

EXPOSE 5000

CMD ["sh", "-c", "python cbr_project/init_db.py && flask --app cbr_project.main:main run --host=0.0.0.0 --port=5000"]
