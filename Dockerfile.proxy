FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY cbr_project ./cbr_project

ENV BACKEND_URL=http://backend:5000 \
    PROXY_HOST=0.0.0.0 \
    PROXY_PORT=8080 \
    PYTHONUNBUFFERED=1

EXPOSE 8080

CMD ["uvicorn", "cbr_project.proxy.app:app", "--host", "0.0.0.0", "--port", "8080"]
